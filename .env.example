# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. Server-side Gemini AI Key (Required for AI Travel Assistant)
GEMINI_API_KEY=

# 2. Firebase Configuration (Handled automatically by firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# 3. Google Maps Key (Optional; OpenStreetMap used as local fallback)
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# 4. App Base URL
APP_URL=

