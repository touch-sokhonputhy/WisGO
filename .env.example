# GEMINI_API_KEY: Required for Gemini AI Travel Assistant API calls.
# Set this in Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="your_gemini_api_key_here"

# VITE_GOOGLE_MAPS_PLATFORM_KEY or GOOGLE_MAPS_PLATFORM_KEY (Optional for Google Maps vector rendering)
VITE_GOOGLE_MAPS_PLATFORM_KEY="your_google_maps_key_here"
GOOGLE_MAPS_PLATFORM_KEY="your_google_maps_key_here"

# APP_URL: Optional base URL of your deployed application
APP_URL="https://your-app.vercel.app"

